###############################################################################
# ProRes QC Inspector
# .gitignore
###############################################################################

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode user data
**/xcuserdata/
*.xcuserstate

# Xcode build products
build/
Build/
DerivedData/

# Swift Package Manager
.build/
Packages/
.swiftpm/

# Playground files
timeline.xctimeline
playground.xcworkspace

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# CocoaPods (not currently used)
Pods/

# Carthage (not currently used)
Carthage/Build/

# Temporary files
*.swp
*.tmp
*.bak
*.orig

# Logs
*.log
*.crash

# Code Coverage
*.profdata

# Archives
*.xcarchive

# Finder metadata
.Spotlight-V100
.Trashes

# Xcode Cloud
ci_scripts/
